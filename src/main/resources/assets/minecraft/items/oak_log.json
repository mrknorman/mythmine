{
	"model": {
		"type": "minecraft:condition",
		"property": "minecraft:has_component",
		"component": "mythstack:variant_pile",
		"on_true": {
			"type": "minecraft:select",
			"property": "mythstack:content_variant",
			"index": 0,
			"cases": [
				{ "when": "minecraft:oak_log", "model": { "type": "minecraft:model", "model": "minecraft:block/oak_log" } },
				{ "when": "minecraft:spruce_log", "model": { "type": "minecraft:model", "model": "minecraft:block/spruce_log" } },
				{ "when": "minecraft:birch_log", "model": { "type": "minecraft:model", "model": "minecraft:block/birch_log" } },
				{ "when": "minecraft:jungle_log", "model": { "type": "minecraft:model", "model": "minecraft:block/jungle_log" } },
				{ "when": "minecraft:acacia_log", "model": { "type": "minecraft:model", "model": "minecraft:block/acacia_log" } },
				{ "when": "minecraft:dark_oak_log", "model": { "type": "minecraft:model", "model": "minecraft:block/dark_oak_log" } },
				{ "when": "minecraft:mangrove_log", "model": { "type": "minecraft:model", "model": "minecraft:block/mangrove_log" } },
				{ "when": "minecraft:cherry_log", "model": { "type": "minecraft:model", "model": "minecraft:block/cherry_log" } },
				{ "when": "minecraft:pale_oak_log", "model": { "type": "minecraft:model", "model": "minecraft:block/pale_oak_log" } }
			],
			"fallback": { "type": "minecraft:model", "model": "minecraft:block/oak_log" }
		},
		"on_false": { "type": "minecraft:model", "model": "minecraft:block/oak_log" }
	}
}
